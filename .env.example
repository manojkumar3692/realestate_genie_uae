# Postgres (Supabase) — Project Settings -> Database -> Connection string -> Transaction pooler
# Used by the app at runtime (correct choice for a serverless/Vercel deployment).
DATABASE_URL=postgres://postgres.xxxxx:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Optional but recommended: Project Settings -> Database -> Connection string -> "Session pooler"
# (port 5432) or "Direct connection". Used only by drizzle-kit (db:push / db:studio) — its
# introspection queries run many concurrent statements, which the Transaction pooler above
# doesn't handle safely (it can mix up results between concurrent queries). Falls back to
# DATABASE_URL if unset.
DIRECT_URL=postgres://postgres.xxxxx:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase Storage (for uploaded CSV/XLSX file retention)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=imports

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# AI provider (optional). Without this the app runs fully on deterministic
# matching/parsing and falls back to templated explanations instead of
# LLM-written ones.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
